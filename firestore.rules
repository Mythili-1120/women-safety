rules_version = '2';

// =====================================================================
// Women Safety Alert System - Firestore Security Rules
// Deploy with:  firebase deploy --only firestore:rules
// (or paste into Firebase console > Firestore > Rules)
// =====================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin check: a user is an admin only if a doc with their uid exists
    // in the "admin_users" collection. Admin docs are created manually in
    // the Firebase console, so no client can grant itself admin rights.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admin_users/$(request.auth.uid));
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(field) {
      return isSignedIn() && request.auth.uid == field;
    }

    // ---------------------------------------------------------------
    // users - one profile document per registered user
    // ---------------------------------------------------------------
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.phone is string;
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isOwner(uid) || isAdmin();
    }

    // ---------------------------------------------------------------
    // emergency_contacts - private phone list of each user
    // ---------------------------------------------------------------
    match /emergency_contacts/{contactId} {
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ---------------------------------------------------------------
    // emergency_alerts - SOS records with location data (sensitive)
    // ---------------------------------------------------------------
    match /emergency_alerts/{alertId} {
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isOwner(request.resource.data.userId)
        && request.resource.data.status in ['active', 'cancelled'];
      // Users may only cancel (never silently edit) their own alerts;
      // admins may resolve any alert.
      allow update: if (isSignedIn() && resource.data.userId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'cancelledAt', 'lastLocationUpdate', 'contactsNotified', 'location', 'locationAvailable', 'updatedAt'])
          && request.resource.data.status in ['active', 'cancelled'])
        || isAdmin();
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------
    // location_shares - live location sessions (highly sensitive)
    // ---------------------------------------------------------------
    match /location_shares/{shareId} {
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isOwner(request.resource.data.userId);
      allow update: if (isSignedIn() && resource.data.userId == request.auth.uid)
        || isAdmin();
      allow delete: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ---------------------------------------------------------------
    // reported_incidents - community safety reports
    // ---------------------------------------------------------------
    match /reported_incidents/{incidentId} {
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isOwner(request.resource.data.userId)
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 1000;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------
    // admin_users - created ONLY from the Firebase console.
    // Clients may read their own admin doc to verify their role,
    // but can never create, update or delete admin docs.
    // ---------------------------------------------------------------
    match /admin_users/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow list: if isAdmin();
      allow write: if false; // console / server SDK only
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
