# ------------------------------------------------------------------
# Women Safety Alert System - environment variables
# 1. Copy this file to ".env"      ->  cp .env.example .env
# 2. Fill in your real Firebase web-app config (Firebase console >
#    Project settings > General > Your apps > SDK setup and config)
# 3. Enable Email/Password sign-in in Firebase console > Authentication
# 4. Create a Firestore database (production mode) and deploy the
#    security rules from firestore.rules
# 5. Optional: Google Maps JavaScript API key for the map views
#    (Google Cloud console > APIs & Services > enable "Maps JavaScript API"
#    and "Places API", then create a browser API key)
# ------------------------------------------------------------------

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional - enables the interactive Google Map + nearby places search.
# Without it the app still works and shows direct Google Maps links.
VITE_GOOGLE_MAPS_API_KEY=
